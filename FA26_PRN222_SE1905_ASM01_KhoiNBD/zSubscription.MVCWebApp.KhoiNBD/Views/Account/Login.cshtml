@model zSubscription.MVCWebApp.KhoiNBD.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="login-shell">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="card login-card">
                <div class="row g-0">
                    <div class="col-lg-5 login-accent d-none d-lg-flex flex-column justify-content-between">
                        <div>
                            <span class="eyebrow">KhoiNBD Membership</span>
                            <h1 class="h2 fw-bold mt-2">Chào mừng bạn quay lại.</h1>
                            <p class="mt-3 mb-0">Đăng nhập để quản lý khoản phí và thông tin hội viên.</p>
                        </div>
                        <div class="small opacity-75 mt-5">Assignment 01 · ASP.NET Core MVC</div>
                    </div>
                    <div class="col-lg-7">
                        <div class="card-body p-4 p-md-5">
                            <span class="eyebrow text-primary">Tài khoản hệ thống</span>
                            <h2 class="h3 fw-bold mb-2">Đăng nhập</h2>
                            <p class="text-muted mb-4">Nhập tài khoản đã được cấp để tiếp tục.</p>
                            <form asp-controller="Account" asp-action="Login" method="post">
                                <input asp-for="ReturnUrl" type="hidden" />
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label">Tên đăng nhập</label>
                                    <input asp-for="UserName" class="form-control form-control-lg" autocomplete="username" placeholder="Nhập tên đăng nhập" autofocus />
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>
                                <div class="mb-4">
                                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                                    <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg w-100">Đăng nhập</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
