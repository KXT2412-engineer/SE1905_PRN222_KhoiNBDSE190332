@{
    ViewData["Title"] = "Tổng quan";
}

<section class="hero-panel mb-4">
    <div class="hero-content">
        <span class="eyebrow">Assignment 01 · MVC</span>
        <h1>Quản lý hội viên gọn gàng, rõ ràng và hiệu quả.</h1>
        <p class="lead mb-0">
            Theo dõi khoản phí, thời hạn và gói membership trong một giao diện thống nhất.
            Tìm kiếm nhanh, thao tác an toàn và hiển thị tốt trên mọi kích thước màn hình.
        </p>
        <div class="hero-actions">
            <a asp-controller="MembershipFees" asp-action="Index" class="btn btn-light btn-lg px-4">
                Mở danh sách khoản phí
            </a>
            <a asp-controller="MembershipFees" asp-action="Create" class="btn btn-outline-light btn-lg px-4">
                Tạo khoản phí mới
            </a>
        </div>
    </div>
</section>
<section class="row g-3">
    <div class="col-md-4">
        <article class="feature-card">
            <div class="feature-icon">01</div>
            <h2>CRUD bằng MVC</h2>
            <p>Tạo, xem, chỉnh sửa và xoá dữ liệu qua Controller, Service và Razor View.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="feature-card">
            <div class="feature-icon">02</div>
            <h2>Tìm kiếm linh hoạt</h2>
            <p>Lọc theo tên hội viên, trạng thái hoạt động và tên gói membership.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="feature-card">
            <div class="feature-icon">03</div>
            <h2>Trải nghiệm responsive</h2>
            <p>Bảng dữ liệu, biểu mẫu và phân trang được tối ưu cho desktop lẫn mobile.</p>
        </article>
    </div>
</section>
