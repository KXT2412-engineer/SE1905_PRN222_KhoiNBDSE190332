@{
    ViewData["Title"] = "SignalR Chat";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm" style="border-radius:14px;">
                <div class="card-header text-white" style="background: linear-gradient(90deg,#1e3a8a,#2563eb); border-radius:14px 14px 0 0;">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-chat-dots-fill me-2"></i>SignalR Real-Time Chat
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="row p-1 mb-2">
                        <div class="col-2 fw-semibold">User</div>
                        <div class="col-10">
                            <input type="text" id="userInput" class="form-control" placeholder="Enter your name..." />
                        </div>
                    </div>
                    <div class="row p-1 mb-3">
                        <div class="col-2 fw-semibold">Message</div>
                        <div class="col-10">
                            <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
                        </div>
                    </div>
                    <div class="row p-1 mb-3">
                        <div class="col-12 text-end">
                            <input type="button" id="sendButton" class="btn btn-primary px-4" value="Send Message" />
                        </div>
                    </div>
                    <hr />
                    <h5 class="fw-semibold text-secondary mb-3">
                        <i class="bi bi-chat-left-text me-1"></i>Messages
                    </h5>
                    <div class="p-3 bg-light rounded" style="min-height: 180px; max-height: 350px; overflow-y: auto;">
                        <ul id="messagesList" class="list-unstyled mb-0"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/chat.js"></script>
}
