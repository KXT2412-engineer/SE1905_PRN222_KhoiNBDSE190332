@model zSubscription.Entities.KhoiNBD.Models.MembershipFeeKhoiNbd

@{
    ViewData["Title"] = "Edit Member Fee";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-header text-white" style="background: linear-gradient(90deg,#1e3a8a,#2563eb); border-radius:14px 14px 0 0;">
        <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Member Fee</h4>
    </div>
    <div class="card-body p-4" id="depositSliptID">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MembershipFeeKhoiNbdid" />
            <input type="hidden" id="CashDepositSlipId" value="@Model.MembershipFeeKhoiNbdid" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MemberName" class="form-label fw-semibold"></label>
                    <input asp-for="MemberName" id="MemberName" class="form-control" />
                    <span asp-validation-for="MemberName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Amount" class="form-label fw-semibold"></label>
                    <input asp-for="Amount" id="Amount" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PaymentDate" class="form-label fw-semibold"></label>
                    <input asp-for="PaymentDate" class="form-control" />
                    <span asp-validation-for="PaymentDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label fw-semibold"></label>
                    <input asp-for="EndDate" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FeePackageKhoiNbdid" class="form-label fw-semibold">Package</label>
                    <select asp-for="FeePackageKhoiNbdid" id="FeePackageKhoiNbdid" class="form-control" asp-items="ViewBag.FeePackageKhoiNbdid"></select>
                    <span asp-validation-for="FeePackageKhoiNbdid" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PaymentMethod" class="form-label fw-semibold"></label>
                    <input asp-for="PaymentMethod" class="form-control" />
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TransactionCode" class="form-label fw-semibold">Code / Transaction Code</label>
                    <input asp-for="TransactionCode" id="Code" class="form-control" />
                    <span asp-validation-for="TransactionCode" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <input asp-for="Status" class="form-control" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="Notes" class="form-label fw-semibold"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label fw-semibold" asp-for="IsActive">Is Active</label>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <input type="submit" value="Save" class="btn btn-primary px-4 me-2" />
                <input type="button" id="btnUpdateBySignalR" value="Update by SignalR" class="btn btn-warning text-dark px-4 me-2" />
                <a asp-action="Index" class="btn btn-outline-secondary px-3">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        var connection = new signalR.HubConnectionBuilder().withUrl("/zPaymentHub").build();

        connection.start().then(function () {
            console.log("Connected to the SignalR Hub");
        }).catch(function (err) {
            return console.error(err.toString());
        });

        connection.on("Receiver_DeleteTransactionCashDepositSlip", function (depositSlipId) {
            document.getElementById("depositSliptID").innerHTML = "This item was deleted";
        });

        document.getElementById("btnUpdateBySignalR").addEventListener("click", function (event) {

            var dataObj = JSON.stringify({
                CashDepositSlipId: document.getElementById("CashDepositSlipId").value,
                Code: document.getElementById("Code").value,
                MemberName: document.getElementById("MemberName") ? document.getElementById("MemberName").value : "",
                Amount: document.getElementById("Amount") ? document.getElementById("Amount").value : "0",
                FeePackageKhoiNbdid: document.getElementById("FeePackageKhoiNbdid") ? document.getElementById("FeePackageKhoiNbdid").value : ""
            });

            console.log(dataObj);

            connection.invoke("HubUpdate_TransactionCashDepositSlip", dataObj).then(function () {
                window.location.href = '@Url.Action("Index")';
            }).catch(function (err) {
                return console.error(err.toString());
            });
            event.preventDefault();

        });
    </script>
}
