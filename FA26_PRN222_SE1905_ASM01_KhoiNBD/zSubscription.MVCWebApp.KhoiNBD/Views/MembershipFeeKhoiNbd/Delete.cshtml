@model zSubscription.Entities.KhoiNBD.Models.MembershipFeeKhoiNbd

@{
    ViewData["Title"] = "Delete";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-header bg-danger text-white" style="border-radius:14px 14px 0 0;">
        <h4 class="mb-0 fw-bold"><i class="bi bi-trash-fill me-2"></i>Delete Member Fee Transaction</h4>
    </div>
    <div class="card-body p-4">
        <h5 class="text-danger mb-3">Are you sure you want to delete this?</h5>
        <dl class="row">
            <dt class="col-sm-3 fw-semibold">Member Name</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.MemberName)</dd>

            <dt class="col-sm-3 fw-semibold">Amount</dt>
            <dd class="col-sm-9 text-success fw-bold">@Model.Amount.ToString("N0") ₫</dd>

            <dt class="col-sm-3 fw-semibold">Payment Date</dt>
            <dd class="col-sm-9">@Model.PaymentDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 fw-semibold">Expiry Date</dt>
            <dd class="col-sm-9">@Model.EndDate?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 fw-semibold">Package</dt>
            <dd class="col-sm-9">@(Model.FeePackageKhoiNbd?.PackageName ?? "N/A")</dd>

            <dt class="col-sm-3 fw-semibold">Status</dt>
            <dd class="col-sm-9">@(Model.Status == 1 ? "Active" : "Inactive")</dd>
        </dl>
        
        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="MembershipFeeKhoiNbdid" />
            <input type="submit" value="Delete" class="btn btn-danger px-3 me-2" />
            <input type="button" id="btnDeleteBySignalR" value="Delete by SignalR" class="btn btn-success px-3 me-2" />
            <a asp-action="Index" class="btn btn-outline-secondary px-3">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/zPaymentHub")
            .build();

        connection.start().catch(err => console.error(err.toString()));

        document.getElementById("btnDeleteBySignalR").addEventListener("click", function (event) {
            const id = "@Model.MembershipFeeKhoiNbdid";
            connection.invoke("HubDelete_TransactionCashDepositSlip", id).then(function () {
                window.location.href = '@Url.Action("Index")';
            }).catch(err => console.error(err.toString()));
        });
    </script>
}
