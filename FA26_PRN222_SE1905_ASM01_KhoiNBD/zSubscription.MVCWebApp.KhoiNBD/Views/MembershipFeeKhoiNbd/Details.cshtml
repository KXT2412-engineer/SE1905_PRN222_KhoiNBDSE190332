@model zSubscription.Entities.KhoiNBD.Models.MembershipFeeKhoiNbd

@{
    ViewData["Title"] = "Details";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-header text-white" style="background: linear-gradient(90deg,#1e3a8a,#2563eb); border-radius:14px 14px 0 0;">
        <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Member Fee Details</h4>
    </div>
    <div class="card-body p-4" id="depositSliptID">
        <dl class="row">
            <dt class="col-sm-3 fw-semibold">Member Name / Depositor</dt>
            <dd class="col-sm-9"><span id="DepositorName" class="px-2 py-1 rounded">@Html.DisplayFor(model => model.MemberName)</span></dd>

            <dt class="col-sm-3 fw-semibold">Amount</dt>
            <dd class="col-sm-9 text-success fw-bold">@Model.Amount.ToString("N0") ₫</dd>

            <dt class="col-sm-3 fw-semibold">Payment Date</dt>
            <dd class="col-sm-9">@Model.PaymentDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 fw-semibold">Expiry Date</dt>
            <dd class="col-sm-9">@Model.EndDate?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 fw-semibold">Package</dt>
            <dd class="col-sm-9">@(Model.FeePackageKhoiNbd?.PackageName ?? "N/A")</dd>

            <dt class="col-sm-3 fw-semibold">Payment Method</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PaymentMethod)</dd>

            <dt class="col-sm-3 fw-semibold">Transaction Code / Code</dt>
            <dd class="col-sm-9"><span id="Code" class="px-2 py-1 rounded">@Html.DisplayFor(model => model.TransactionCode)</span></dd>

            <dt class="col-sm-3 fw-semibold">Notes</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>

            <dt class="col-sm-3 fw-semibold">Status</dt>
            <dd class="col-sm-9">@(Model.Status == 1 ? "Active" : "Inactive")</dd>

            <dt class="col-sm-3 fw-semibold">Is Active</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
        </dl>
        <div class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.MembershipFeeKhoiNbdid" class="btn btn-primary px-3 me-2">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/zPaymentHub")
            .build();

        connection.start().catch(err => console.error(err.toString()));

        connection.on("Receiver_DeleteTransactionCashDepositSlip", function (depositSlipId) {
            if (!depositSlipId || depositSlipId == "@Model?.MembershipFeeKhoiNbdid") {
                document.getElementById("depositSliptID").innerHTML = "<div class='alert alert-danger fs-4 fw-bold p-4 text-center'><i class='bi bi-trash3-fill me-2'></i>This item was deleted</div><div class='text-center mt-3'><a href='@Url.Action("Index")' class='btn btn-outline-secondary'>Back to List</a></div>";
            }
        });

        connection.on("Receiver_UpdateTransactionCashDepositSlip", function (depositSlip) {
            if (typeof depositSlip === "string") {
                try { depositSlip = JSON.parse(depositSlip); } catch(e) {}
            }

            if (depositSlip) {
                if (document.getElementById("Code")) {
                    document.getElementById("Code").innerHTML = depositSlip.code || depositSlip.Code || "";
                    document.getElementById("Code").style.color = "blue";
                    document.getElementById("Code").style.backgroundColor = "yellow";
                }

                if (document.getElementById("DepositorName") && (depositSlip.depositorName || depositSlip.memberName)) {
                    document.getElementById("DepositorName").innerHTML = depositSlip.depositorName || depositSlip.memberName;
                    document.getElementById("DepositorName").style.color = "blue";
                    document.getElementById("DepositorName").style.backgroundColor = "yellow";
                }
            }
        });
    </script>
}
