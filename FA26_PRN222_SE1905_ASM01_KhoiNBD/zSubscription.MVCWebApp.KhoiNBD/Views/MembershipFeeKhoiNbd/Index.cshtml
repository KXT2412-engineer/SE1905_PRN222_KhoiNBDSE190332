@model IEnumerable<zSubscription.Entities.KhoiNBD.Models.MembershipFeeKhoiNbd>
@{
    ViewData["Title"] = "Members";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0" style="background: linear-gradient(90deg,#1e3a8a,#0ea5e9); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">
        <i class="bi bi-people me-2" style="-webkit-text-fill-color:#2563eb"></i>Members
        <span class="badge bg-primary ms-2 fs-6" style="-webkit-text-fill-color:#fff">@totalItems</span>
    </h2>
    <a asp-action="Create" class="btn btn-success px-4">
        <i class="bi bi-plus-circle me-1"></i> Add New
    </a>
</div>

@* Search Form - 3 conditions *@
<div class="card border-0 shadow-sm mb-4" style="border-radius:14px; background: linear-gradient(135deg,#dbeafe,#f0fdf4);">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-primary">
                        <i class="bi bi-person-search me-1"></i>Member Name
                    </label>
                    <input type="text" name="searchName" value="@ViewBag.SearchName"
                           class="form-control border-primary" placeholder="Search by name..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-primary">
                        <i class="bi bi-toggle-on me-1"></i>Status
                    </label>
                    <select name="searchStatus" class="form-select border-primary">
                        <option value="">-- All Status --</option>
                        <option value="1" selected="@(ViewBag.SearchStatus != null && ViewBag.SearchStatus == 1 ? "selected" : null)">Active</option>
                        <option value="0" selected="@(ViewBag.SearchStatus != null && ViewBag.SearchStatus == 0 ? "selected" : null)">Inactive</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-primary">
                        <i class="bi bi-check2-circle me-1"></i>Is Active
                    </label>
                    <select name="isActive" class="form-select border-primary">
                        <option value="">-- All --</option>
                        <option value="true" selected="@(ViewBag.IsActive != null && ViewBag.IsActive == true ? "selected" : null)">Yes</option>
                        <option value="false" selected="@(ViewBag.IsActive != null && ViewBag.IsActive == false ? "selected" : null)">No</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius:14px; overflow:hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tblCashDepositSlipsID">
            <thead style="background: linear-gradient(90deg,#1e3a8a,#2563eb); color:#fff;">
                <tr>
                    <th class="ps-3">#</th>
                    <th>Member Name</th>
                    <th class="text-end">Amount</th>
                    <th>Join Date</th>
                    <th>Expiry Date</th>
                    <th>Package</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="depositSlipTBodyID">
                @{ int no = (currentPage - 1) * 5 + 1; }
                @foreach (var item in Model)
                {
                    <tr id="@item.MembershipFeeKhoiNbdid">
                        <td class="ps-3 text-muted small">@(no++)</td>
                        <td class="fw-semibold">@item.MemberName</td>
                        <td class="text-end fw-bold text-success">@item.Amount.ToString("N0") ₫</td>
                        <td class="small">@item.PaymentDate.ToString("dd/MM/yyyy")</td>
                        <td class="small">@item.EndDate?.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge bg-info text-dark">@(item.FeePackageKhoiNbd?.PackageName ?? "N/A")</span></td>
                        <td class="text-center">
                            @if (item.Status == 1)
                            { <span class="badge bg-success">Active</span> }
                            else
                            { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td class="text-center">
                            @if (item.IsActive)
                            { <i class="bi bi-check-circle-fill text-success fs-5"></i> }
                            else
                            { <i class="bi bi-x-circle-fill text-danger fs-5"></i> }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.MembershipFeeKhoiNbdid" class="btn btn-sm btn-outline-primary me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@item.MembershipFeeKhoiNbdid" class="btn btn-sm btn-outline-info me-1" title="Details"><i class="bi bi-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.MembershipFeeKhoiNbdid" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>No records found.
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Pagination *@
@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage-1)"
                   asp-route-searchName="@ViewBag.SearchName" asp-route-searchStatus="@ViewBag.SearchStatus"
                   asp-route-isActive="@ViewBag.IsActive">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                       asp-route-searchName="@ViewBag.SearchName" asp-route-searchStatus="@ViewBag.SearchStatus"
                       asp-route-isActive="@ViewBag.IsActive">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage+1)"
                   asp-route-searchName="@ViewBag.SearchName" asp-route-searchStatus="@ViewBag.SearchStatus"
                   asp-route-isActive="@ViewBag.IsActive">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
    <p class="text-center text-muted small">Page @currentPage / @totalPages &nbsp;·&nbsp; @totalItems records total</p>
}

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/zPaymentHub")
            .build();

        connection.start().catch(err => console.error(err.toString()));

        connection.on("Receiver_DeleteTransactionCashDepositSlip", function (id) {
            //alert($("#{TermDepositSlipId}").value);
            $('#depositSlipTBodyID').find(`tr[id='${id}']`).remove();
        });

        connection.on("Receiver_CreateTransactionCashDepositSlip", function(item) {
            var trTransactionCashDepositSlip = `
                    <tr class="bg-warning text-danger fw-bold" id="${item.id || ''}">
                    <td>${item.code}</td>
                    <td>${item.cashDepositDate}</td>
                    <td>${item.depositorName}</td>
                    <td>${item.accountNo}</td>
                    <td>${item.withBank}</td>
                    <td>${item.amountInFigures}</td>
                    <td>${item.currencyCode}</td>
                    <td>${item.tellerCode}</td>
                    <td>${item.supervisor}</td>
                    <td></td>
                </tr>
            `;

            $('#tblCashDepositSlipsID').prepend(trTransactionCashDepositSlip);
        });
    </script>
}
