@model zSubscription.Entities.KhoiNBD.Models.MembershipFeeKhoiNbd
@{
    ViewData["Title"] = "Create Membership Fee";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Create Membership Fee</h1>
        <p class="text-muted mb-0">Tạo mới bằng form MVC (POST + ValidateAntiForgeryToken).</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" data-membership-fee-form>
            <partial name="_Form" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <button type="button" class="btn btn-success" data-sr-form-action="create">Create bằng SignalR</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/membership-fee-form-signalr.js" asp-append-version="true"></script>
}
