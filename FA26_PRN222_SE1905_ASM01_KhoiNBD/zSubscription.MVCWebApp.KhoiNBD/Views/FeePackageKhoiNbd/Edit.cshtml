@model zSubscription.Entities.KhoiNBD.Models.FeePackageKhoiNbd

@{
    ViewData["Title"] = "Edit Fee Package";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-header text-white" style="background: linear-gradient(90deg,#1e3a8a,#2563eb); border-radius:14px 14px 0 0;">
        <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Fee Package</h4>
    </div>
    <div class="card-body p-4" id="depositSliptID">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FeePackageKhoiNbdid" />
            <input type="hidden" id="CashDepositSlipId" value="@Model.FeePackageKhoiNbdid" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PackageName" class="form-label fw-semibold"></label>
                    <input asp-for="PackageName" id="Code" class="form-control" />
                    <span asp-validation-for="PackageName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DurationInDays" class="form-label fw-semibold"></label>
                    <input asp-for="DurationInDays" class="form-control" />
                    <span asp-validation-for="DurationInDays" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <input asp-for="Status" class="form-control" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="mt-3">
                <input type="submit" value="Save" class="btn btn-primary px-4 me-2" />
                <input type="button" id="btnUpdateBySignalR" value="Update by SignalR" class="btn btn-warning text-dark px-4 me-2" />
                <a asp-action="Index" class="btn btn-outline-secondary px-3">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        var connection = new signalR.HubConnectionBuilder().withUrl("/zPaymentHub").build();

        connection.start().then(function () {
            console.log("Connected to the SignalR Hub");
        }).catch(function (err) {
            return console.error(err.toString());
        });

        connection.on("Receiver_DeleteTransactionCashDepositSlip", function (depositSlipId) {
            document.getElementById("depositSliptID").innerHTML = "This item was deleted";
        });

        document.getElementById("btnUpdateBySignalR").addEventListener("click", function (event) {

            var dataObj = JSON.stringify({
                CashDepositSlipId: document.getElementById("CashDepositSlipId").value,
                Code: document.getElementById("Code").value
            });

            console.log(dataObj);

            connection.invoke("HubUpdate_TransactionCashDepositSlip", dataObj).then(function () {
                window.location.href = '@Url.Action("Index")';
            }).catch(function (err) {
                return console.error(err.toString());
            });
            event.preventDefault();

        });
    </script>
}
