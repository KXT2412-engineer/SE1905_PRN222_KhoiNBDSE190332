@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập · ASM3</title>
    <link rel="stylesheet" href="~/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" />
    <style>
        .auth-page { min-height: 100vh; display: grid; place-items: center; padding: 2rem 1rem; }
        .auth-card { width: min(100%, 960px); overflow: hidden; border: 0; border-radius: 1.25rem; box-shadow: 0 24px 70px rgba(23, 32, 51, .16); }
        .auth-visual { min-height: 480px; padding: 2.5rem; color: #fff; background: linear-gradient(145deg, #172033, #5b21b6 70%, #db2777); }
        .auth-form { padding: clamp(1.5rem, 5vw, 3.5rem); }
        .auth-mark { display: inline-grid; width: 3rem; height: 3rem; place-items: center; border-radius: 1rem; background: linear-gradient(135deg, #7c3aed, #ec4899); font-weight: 800; }
        .auth-label { color: #7c3aed; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
        .auth-input { min-height: 3.25rem; border-radius: .8rem; }
        .auth-submit { min-height: 3.2rem; border: 0; border-radius: .8rem; background: linear-gradient(110deg, #7c3aed, #5b21b6); font-weight: 700; }
        .auth-submit:hover { background: linear-gradient(110deg, #6d28d9, #4c1d95); }
        @@media (max-width: 767.98px) { .auth-visual { min-height: auto; padding: 1.5rem; } }
    </style>
</head>
<body>
    <main class="auth-page">
        <div class="card auth-card">
            <div class="row g-0">
                <section class="col-md-5 auth-visual d-flex flex-column justify-content-between">
                    <div>
                        <span class="auth-mark">A3</span>
                        <p class="mt-4 mb-2 text-uppercase small fw-bold opacity-75">KhoiNBD Interactive</p>
                        <h1 class="display-6 fw-bold">Chào mừng bạn quay lại.</h1>
                        <p class="mt-3 opacity-75">Đăng nhập để quản lý khoản phí hội viên ngay trên giao diện Blazor.</p>
                    </div>
                    <span class="small opacity-75 mt-4">Assignment 03 · Blazor Server</span>
                </section>
                <section class="col-md-7 auth-form">
                    <span class="auth-label">Tài khoản hệ thống</span>
                    <h2 class="h3 fw-bold mt-2 mb-2">Đăng nhập</h2>
                    <p class="text-muted mb-4">Nhập tài khoản đã được cấp để tiếp tục.</p>
                    <form asp-controller="Account" asp-action="Login" method="post">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label fw-semibold">Tên đăng nhập</label>
                            <input asp-for="UserName" class="form-control form-control-lg auth-input" autocomplete="username" placeholder="Nhập tên đăng nhập" required autofocus />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                            <input asp-for="Password" class="form-control form-control-lg auth-input" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 auth-submit">Đăng nhập</button>
                    </form>
                    <p class="text-muted small mt-4 mb-0">Sử dụng thông tin tài khoản được cấp trong hệ thống.</p>
                </section>
            </div>
        </div>
    </main>
</body>
</html>
