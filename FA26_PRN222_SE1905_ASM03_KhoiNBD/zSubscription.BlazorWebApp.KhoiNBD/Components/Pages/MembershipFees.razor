@page "/membership-fees"

<PageTitle>Membership Fees · ASM3</PageTitle>

<MembershipFeeTable RefreshKey="@refreshKey"
                    OnCreate="BeginCreate"
                    OnEdit="BeginEdit"
                    OnDelete="BeginDelete" />

@if (showCreate || editingItem is not null || deletingItem is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" role="dialog" aria-modal="true" aria-label="Thao tác khoản phí">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-body">
                    @if (showCreate)
                    {
                        <CreateMembershipFee OnSaved="HandleSaved" OnCancel="CloseEditor" />
                    }
                    else if (editingItem is not null)
                    {
                        <EditMembershipFee @key="editingItem.MembershipFeeKhoiNbdid" Item="editingItem"
                                           OnSaved="HandleSaved" OnCancel="CloseEditor" />
                    }
                    else if (deletingItem is not null)
                    {
                        <DeleteMembershipFee @key="deletingItem.MembershipFeeKhoiNbdid" Item="deletingItem"
                                             OnDeleted="HandleDeleted" OnCancel="CloseEditor" />
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show mt-3" role="alert">
        @message
        <button type="button" class="btn-close" @onclick="() => message = null" aria-label="Đóng"></button>
    </div>
}

@code {
    private int refreshKey;
    private bool showCreate;
    private MembershipFeeKhoiNbd? editingItem;
    private MembershipFeeKhoiNbd? deletingItem;
    private string? message;
    private bool isError;

    private void BeginCreate()
    {
        CloseEditor();
        showCreate = true;
    }

    private void BeginEdit(MembershipFeeKhoiNbd item)
    {
        CloseEditor();
        editingItem = item;
    }

    private void BeginDelete(MembershipFeeKhoiNbd item)
    {
        CloseEditor();
        deletingItem = item;
    }

    private void CloseEditor()
    {
        showCreate = false;
        editingItem = null;
        deletingItem = null;
    }

    private Task HandleSaved(string text)
    {
        CloseEditor();
        message = text;
        isError = false;
        refreshKey++;
        return Task.CompletedTask;
    }

    private Task HandleDeleted(string text)
    {
        CloseEditor();
        message = text;
        isError = false;
        refreshKey++;
        return Task.CompletedTask;
    }
}
