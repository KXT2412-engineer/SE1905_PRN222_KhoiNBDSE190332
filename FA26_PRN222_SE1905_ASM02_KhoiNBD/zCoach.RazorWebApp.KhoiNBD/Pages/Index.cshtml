@page
@model IndexModel
@{
    ViewData["Title"] = "Tổng quan";
}

<section class="hero-panel mb-4">
    <div class="hero-content">
        <span class="eyebrow">Assignment 02 · Razor Pages + SignalR</span>
        <h1>Dữ liệu membership cập nhật tức thời.</h1>
        <p class="lead mb-0">
            Quản lý khoản phí bằng Razor Pages, đồng bộ thay đổi qua SignalR và bảo vệ
            chức năng nghiệp vụ bằng đăng nhập cookie.
        </p>
        <div class="hero-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/MembershipFeesKhoiNbd/Index" class="btn btn-light btn-lg px-4">
                    Mở bảng điều khiển
                </a>
                <a asp-page="/MembershipFeesKhoiNbd/Create" class="btn btn-outline-light btn-lg px-4">
                    Tạo khoản phí mới
                </a>
            }
            else
            {
                <a asp-page="/Account/Login" class="btn btn-light btn-lg px-4">
                    Đăng nhập để bắt đầu
                </a>
            }
        </div>
    </div>
</section>
<section class="row g-3">
    <div class="col-md-6 col-xl-3">
        <article class="feature-card">
            <div class="feature-icon">RP</div>
            <h2>Razor Pages</h2>
            <p>Luồng CRUD rõ ràng với PageModel, handler OnGet và OnPost.</p>
        </article>
    </div>
    <div class="col-md-6 col-xl-3">
        <article class="feature-card">
            <div class="feature-icon">SR</div>
            <h2>SignalR realtime</h2>
            <p>Thao tác tạo, sửa và xoá được gửi đến các phiên đang kết nối.</p>
        </article>
    </div>
    <div class="col-md-6 col-xl-3">
        <article class="feature-card">
            <div class="feature-icon">AU</div>
            <h2>Đăng nhập an toàn</h2>
            <p>Cookie Authentication bảo vệ các màn hình quản lý dữ liệu.</p>
        </article>
    </div>
    <div class="col-md-6 col-xl-3">
        <article class="feature-card">
            <div class="feature-icon">FX</div>
            <h2>Tìm kiếm và lọc</h2>
            <p>Ba tiêu chí tìm kiếm kết hợp phân trang trực quan phía client.</p>
        </article>
    </div>
</section>
