@page
@model zCoach.RazorWebApp.KhoiNBD.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="login-shell">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="card login-card">
                <div class="row g-0">
                    <div class="col-lg-5 login-accent d-none d-lg-flex flex-column justify-content-between">
                        <div>
                            <span class="eyebrow">KhoiNBD Live</span>
                            <h1 class="h2 fw-bold mt-2">Chào mừng bạn quay lại.</h1>
                            <p class="mt-3 mb-0">
                                Đăng nhập để quản lý khoản phí, gói membership và theo dõi
                                thay đổi dữ liệu theo thời gian thực.
                            </p>
                        </div>
                        <div class="small opacity-75 mt-5">
                            Assignment 02 · Razor Pages + SignalR
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="card-body p-4 p-md-5">
                            <div class="mb-4">
                                <span class="eyebrow text-primary">Tài khoản hệ thống</span>
                                <h2 class="h3 fw-bold mb-2">Đăng nhập</h2>
                                <p class="text-muted mb-0">Nhập thông tin tài khoản để tiếp tục.</p>
                            </div>

                            <form method="post">
                                <input type="hidden" asp-for="Input.ReturnUrl" />
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                                <div class="mb-3">
                                    <label asp-for="Input.UserName" class="form-label"></label>
                                    <input asp-for="Input.UserName" class="form-control form-control-lg"
                                           autocomplete="username" placeholder="Nhập username" autofocus />
                                    <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Input.Password" class="form-label"></label>
                                    <input asp-for="Input.Password" class="form-control form-control-lg"
                                           autocomplete="current-password" placeholder="Nhập mật khẩu" />
                                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100">Đăng nhập</button>
                            </form>

                            <div class="mt-4 pt-3 border-top">
                                <span class="text-muted small">Tài khoản mẫu</span>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="badge text-bg-light border">Username: <code>admin</code></span>
                                    <span class="badge text-bg-light border">Password: <code>123456</code></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
